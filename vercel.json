{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/relocate", "destination": "/relocation", "permanent": true },
    { "source": "/home-valuation", "destination": "/home-value", "permanent": true },
    { "source": "/developments", "destination": "/pre-construction", "permanent": true },
    { "source": "/lifestyle", "destination": "/south-florida", "permanent": true },
    { "source": "/blog", "destination": "/journal", "permanent": true },
    { "source": "/blog/:slug", "destination": "/journal/:slug", "permanent": true },
    { "source": "/news", "destination": "/journal", "permanent": true }
  ],
  "rewrites": [
    { "source": "/journal/:slug([a-z0-9-]+)", "destination": "/journal/:slug.html" }
  ],
  "headers": [
    { "source": "/(sitemap|sitemap-pages|sitemap-journal).xml", "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }] },
    { "source": "/journal/rss.xml", "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
